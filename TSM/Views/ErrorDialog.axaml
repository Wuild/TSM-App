<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lucide="using:Lucide.Avalonia"
        x:Class="TSM.Views.ErrorDialog"
        Title="TSM Desktop error"
        Width="620" Height="430" MinWidth="500" MinHeight="340"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        WindowDecorationsTheme="{StaticResource TsmWindowDecorations}"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18" RowSpacing="14">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
      <Border Width="36" Height="36" CornerRadius="18" Background="#39201E">
        <lucide:LucideIcon Kind="CircleAlert" Size="21" StrokeWidth="1.8"
                           Foreground="#F06464" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="Something went wrong" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="The error was recorded. You can copy the details when reporting the problem."
                   Classes="muted" FontSize="10" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="#1B1B1B" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="4" Padding="12,10">
      <StackPanel Spacing="5">
        <TextBlock x:Name="ContextText" Classes="field-label" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="11" LineHeight="17" />
        <TextBlock x:Name="TimestampText" Classes="muted" FontSize="9" />
      </StackPanel>
    </Border>

    <TextBox x:Name="DetailsText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace" FontSize="10"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock x:Name="CopyStatusText" Classes="muted" FontSize="9" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Content="Open log" Click="OpenLogClick" />
        <Button Classes="ghost" Content="Copy details" Click="CopyDetailsClick" />
        <Button Classes="primary" Content="Close" Click="CloseClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
