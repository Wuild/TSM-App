#!/bin/sh
APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

desktop_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
if [ -n "${APPIMAGE:-}" ] && [ -d "$desktop_dir" ]; then
  current_entry=""
  for desktop_file in "$desktop_dir"/*.desktop; do
    [ -f "$desktop_file" ] || continue
    if grep -Fq "$APPIMAGE" "$desktop_file" && grep -qx 'Name=TSM Desktop' "$desktop_file"; then
      current_entry="$desktop_file"
      break
    fi
  done
  if [ -n "$current_entry" ]; then
    for desktop_file in "$desktop_dir"/*.desktop; do
      [ -f "$desktop_file" ] || continue
      [ "$desktop_file" = "$current_entry" ] && continue
      grep -Fq "$APPIMAGE" "$desktop_file" || continue
      if grep -Eq '^Name=(TradeSkillMaster|TradeSkillMaster Cross-Platform)$' "$desktop_file"; then
        rm -f -- "$desktop_file"
      fi
    done
  fi
fi

exec "$APPDIR/usr/bin/TSM" "$@"
